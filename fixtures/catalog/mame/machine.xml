<?xml version="1.0"?>
<!DOCTYPE mame>
<mame build="0.216-synthetic" debug="no" mameconfig="10" xmlns:future="urn:mame:future">
  <machine name="demo_machine" sourcefile="demo.cpp">
    <description>Synthetic Machine</description>
    <year>2000</year>
    <manufacturer>Example</manufacturer>
    <biosset name="demo_bios" description="Demo BIOS" default="yes" />
      <rom name="demo_bios.bin" size="16" crc="12345678" sha1="0123456789abcdef0123456789abcdef01234567" region="maincpu" bios="demo_bios" />
      <rom name="demo_video.bin" size="32" crc="87654321" region="video" />
      <disk name="demo_disk" sha1="1123456789abcdef0123456789abcdef01234567" merge="parent_disk" region="disk" />
      <device_ref name="demo_sound" />
      <feature type="protection" status="imperfect" />
  </machine>
  <machine name="demo_sound" sourcefile="sound.cpp" isdevice="yes" runnable="no" future:flag="preserved">
    <description>Synthetic Sound Device</description>
  </machine>
</mame>
